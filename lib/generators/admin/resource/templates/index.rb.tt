# frozen_string_literal: true

class <%= view_module %>::Index < Views::Base
  include Views::Admin::Formats

  def initialize(page:)
    @page = page
  end

  def view_template
    breadcrumb(["Settings", settings_path], ["Admin", settings_admin_path], "<%= title %>")
    render Views::Admin::Heading.new(
      title: "<%= title %>",
      blurb: "TODO: one sentence saying what this page is for."
    )

    @page.any? ? listing : empty
  end

  private

  def page_title = "<%= title %>"

  def listing
    render Views::Admin::Table.new(
      rows: @page.records,
      fields:,
      href: ->(record) { <%= show_path_helper("record") %> }
    )
    render Views::Pager.new(page: @page, action: <%= index_path_helper %>)
  end

  def fields
    [
      <%= index_fields.join(",\n      ") %>
    ]
  end

  def empty
    render Views::Admin::Empty.new(message: "No <%= human_plural_down %> yet.")
  end
end
