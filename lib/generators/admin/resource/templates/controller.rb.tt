module <%= namespace_module %>
  class <%= controller_class %> < ApplicationController
    require_role :admin

    def index
      render <%= view_module %>::Index.new(
        page: Page.of(<%= class_name %>.all, after: params[:after], before: params[:before])
      )
    end

    def show
      render <%= view_module %>::Show.new(<%= singular_name %>: <%= class_name %>.find(params[:id]))
    end
<% if options[:destroy] -%>

    def destroy
      <%= class_name %>.find(params[:id]).destroy
      redirect_to <%= index_path_helper %>, notice: "Removed."
    end
<% end -%>
  end
end
